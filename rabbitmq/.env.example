# ============================================================
# RabbitMQ — Variables de entorno
# cp .env.example .env  →  edita antes de levantar
# ============================================================

# --- Versión ---
RABBITMQ_VERSION=4-management-alpine

# --- Puertos del host ---
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Credenciales ---
RABBITMQ_DEFAULT_USER=admin
# Generar: openssl rand -base64 16
RABBITMQ_DEFAULT_PASS=C4mbia_esto_AHORA!

# --- Virtual host por defecto ---
RABBITMQ_DEFAULT_VHOST=/

# --- Cookie Erlang (clúster) ---
# Generar: openssl rand -hex 32
# Todos los nodos del clúster deben compartir la misma cookie
RABBITMQ_ERLANG_COOKIE=cambia_esta_cookie_ahora

# --- Hostname del contenedor ---
# Fijarlo evita que cambien las cookies Erlang al reiniciar
RABBITMQ_HOSTNAME=rabbitmq
